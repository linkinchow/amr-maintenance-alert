// Central notification resources: Logic App (workflow.json, generated by scripts/build_templates.py) and the Action Group the rules send to.
targetScope = 'resourceGroup'

param location string = resourceGroup().location
param logicAppName string
param actionGroupName string
param tags object = {}

@secure()
param feishuWebhookUrl string

@description('Lower-case subscription id -> display name; also the workflow allow-list.')
param subscriptionNames object

resource workflow 'Microsoft.Logic/workflows@2019-05-01' = {
  name: logicAppName
  location: location
  tags: tags
  properties: {
    state: 'Enabled'
    definition: loadJsonContent('workflow.json')
    parameters: {
      feishuWebhookUrl: {
        value: feishuWebhookUrl
      }
      subscriptionNames: {
        value: subscriptionNames
      }
      resourceGroupName: {
        value: resourceGroup().name
      }
    }
  }
}

resource actionGroup 'Microsoft.Insights/actionGroups@2023-01-01' = {
  name: actionGroupName
  location: 'global'
  tags: tags
  properties: {
    enabled: true
    groupShortName: 'AMRAlerts'
    emailReceivers: []
    logicAppReceivers: [
      {
        name: 'FeishuAMR'
        resourceId: workflow.id
        callbackUrl: listCallbackUrl('${workflow.id}/triggers/Receive_alert', '2019-05-01').value
        // The workflow reads the native activity log payload first and also accepts the common schema.
        useCommonAlertSchema: false
      }
    ]
  }
}

output actionGroupId string = actionGroup.id
output logicAppId string = workflow.id
